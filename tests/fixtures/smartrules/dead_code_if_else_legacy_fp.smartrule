// Edge: legacy false positive — `if (x) return;` followed by `else`.
// Legacy regex sees `return` on a line, looks at the next non-blank
// line, finds `else { ... }`, and flags it as dead code. The AST-based
// check correctly recognises that the return lives inside the then-
// branch's own block, so the else-branch is reachable.
x := 1;
if (x = 1)
{
  return;
}
else
{
  msginfo("alive");
}
y := 2;
