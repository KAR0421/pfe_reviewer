// SR012.1 negative: same complexity (12 branches), one comment per
// every couple of branches → ratio satisfied (1 comment per 12 covers it).
x1 := 1;
// guard: only handle case 1 explicitly
if (x1 = 1) { y1 := 1; }
if (x1 = 2) { y2 := 1; }
// fallback path for the mid range
if (x1 = 3) { y3 := 1; }
if (x1 = 4) { y4 := 1; }
if (x1 = 5) { y5 := 1; }
// known edge case from production
if (x1 = 6) { y6 := 1; }
if (x1 = 7) { y7 := 1; }
if (x1 = 8) { y8 := 1; }
if (x1 = 9) { y9 := 1; }
if (x1 = 10) { y10 := 1; }
if (x1 = 11) { y11 := 1; }
if (x1 = 12) { y12 := 1; }
